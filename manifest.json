{
  "manifest_version": 3,
  "name": "Pattern Copy",
  "version": "0.1.0",
  "description": "Finds user-defined patterns (paths, IDs, regexps) on any page and offers a one-click copy hint.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pattern-copy@external-team",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "action": {
    "default_title": "Pattern Copy",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/common/api.js",
      "src/common/patterns.js",
      "src/common/tabs.js",
      "src/background/background.js"
    ]
  },
  "commands": {
    "copy-all-matches": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy every match on the current page"
    },
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Turn Pattern Copy highlighting on or off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/common/api.js",
        "src/common/patterns.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
